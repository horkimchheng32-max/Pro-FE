# Copy to .env.local
NEXT_PUBLIC_API_URL=https://sport-api.eunglyzhia.com/api/v1
# Set to true if the browser blocks requests with a CORS error
NEXT_PUBLIC_USE_PROXY=true
# Favorites POST/DELETE exist in Postman only against localhost:8080 - leave false until deployed
NEXT_PUBLIC_ENABLE_FAVORITE_WRITE=true
